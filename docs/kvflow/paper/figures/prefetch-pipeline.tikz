\begingroup
\definecolor{ikvblue}{HTML}{2F6DB3}
\definecolor{ikvnavy}{HTML}{1B4F8A}
\definecolor{ikvteal}{HTML}{5BB3A7}
\definecolor{ikvorange}{HTML}{D96B2B}
\definecolor{ikvgray}{HTML}{6B6B6B}
\definecolor{okfill}{HTML}{E4F3EE}
\begin{tikzpicture}[
  font=\sffamily\scriptsize,
  >=Stealth,
  every node/.style={align=center},
  box/.style={draw=#1, fill=white, rounded corners=3pt, inner sep=3.2pt,
    minimum height=0.88cm},
]
% Row 1. 0.40cm gaps between 1.95cm-class boxes.
\node[box=ikvteal, text width=1.85cm] (m0) at (-3.70,1.25)
  {\textbf{M0 PLAN}\\{\tiny admitted keys}};
\node[box=ikvblue, text width=1.95cm] (obs) at (-1.35,1.25)
  {Later-roles /\\next-island};
\node[box=ikvorange, text width=2.05cm] (hint) at (1.10,1.25)
  {Hint: key, DEVICE,\\deadline};
\node[box=ikvgray, text width=1.80cm] (heap) at (3.55,1.25)
  {Deadline heap};
\draw[->, ikvteal, thick] (m0) -- (obs);
\draw[->, ikvblue, thick] (obs) -- (hint);
\draw[->, ikvorange, thick] (hint) -- (heap);

% Row 2. Gutter from y=0.81 (row1 south) to y=0.12 (row2 north).
\node[box=ikvblue, fill=okfill, minimum width=2.55cm, minimum height=0.72cm]
  (hit) at (-1.55,-0.40) {Hit: pin the page};
\node[box=ikvnavy, minimum width=2.90cm, minimum height=0.72cm]
  (m2) at (1.70,-0.40) {\textbf{M2} copies owned island};
\draw[->, ikvblue, thick] (hit) -- (m2);

% PLAN keys feed M2 along the left then bottom margin, never through Hit.
\draw[->, ikvteal, thick]
  (m0.south) -- ++(0,-0.20) -- (-4.45,0.61) -- (-4.45,-1.02) -- (1.70,-1.02) -- (m2.south);
% Heap hit: down into the gutter, then left to Hit.
\draw[->, ikvblue, thick]
  (heap.south) -- ++(0,-0.28) -| (hit.north);
% Miss: right margin, then down, then into M2. Completely outside the boxes.
\draw[->, ikvorange, thick]
  (heap.east) -- ++(0.40,0) -- ++(0,-1.65) -- (m2.east);
\node[font=\sffamily\tiny, text=ikvorange, anchor=west] at (4.55,0.40) {miss};

\node[font=\sffamily\tiny, text=ikvgray] at (0,-1.38)
  {Skip if already DEVICE and the next use is now. M3 does not grow the admit set.};
\end{tikzpicture}
\endgroup
