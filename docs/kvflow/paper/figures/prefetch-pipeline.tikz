\begingroup
\definecolor{ikvblue}{HTML}{2F6DB3}
\definecolor{ikvnavy}{HTML}{1B4F8A}
\definecolor{ikvteal}{HTML}{5BB3A7}
\definecolor{ikvorange}{HTML}{D96B2B}
\definecolor{ikvgray}{HTML}{6B6B6B}
\definecolor{okfill}{HTML}{E4F3EE}
\definecolor{dimfill}{HTML}{F3F3F3}
\begin{tikzpicture}[
  font=\sffamily\scriptsize,
  >=Stealth,
]
\node[draw=ikvteal, fill=white, rounded corners=3pt, align=center,
  inner sep=4pt, text width=1.85cm, minimum height=1.05cm] (m0) at (-3.35,0.85)
  {\textbf{M0 PLAN}\\admitted keys only};
\node[draw=ikvblue, fill=white, rounded corners=3pt, align=center,
  inner sep=4pt, text width=2.05cm, minimum height=1.05cm] (obs) at (-1.05,0.85)
  {Later-roles /\\next-island};
\node[draw=ikvorange, fill=white, rounded corners=3pt, align=center,
  inner sep=4pt, text width=2.15cm, minimum height=1.05cm] (hint) at (1.35,0.85)
  {Hint: key, DEVICE,\\deadline, priority};
\node[draw=ikvgray, fill=white, rounded corners=3pt, align=center,
  inner sep=4pt, text width=1.85cm, minimum height=1.05cm] (heap) at (3.55,0.85)
  {Deadline heap\\async load};
\draw[->, ikvteal, thick] (m0) -- (obs);
\draw[->, ikvblue, thick] (obs) -- (hint);
\draw[->, ikvorange, thick] (hint) -- (heap);

\node[draw=ikvblue, fill=okfill, rounded corners=3pt, align=center,
  inner sep=4pt, text width=2.45cm, minimum height=0.85cm] (hit) at (-1.35,-0.55)
  {Hit: pin resident page};
\node[draw=ikvnavy, fill=white, rounded corners=3pt, align=center,
  inner sep=4pt, text width=2.65cm, minimum height=0.85cm] (m2) at (1.85,-0.55)
  {\textbf{M2 copies owned island}};
\node[draw=ikvgray, fill=dimfill, rounded corners=3pt, align=center,
  inner sep=3pt, text width=2.35cm, font=\sffamily\tiny] (skip) at (3.55,-1.55)
  {Skip if already DEVICE\\and next use is now};
\draw[->, ikvteal, thick] (m0.south) |- (m2.west);
\draw[->, ikvblue] (heap.south) |- node[font=\sffamily\tiny, text=ikvblue, pos=0.2] {resident} (hit.east);
\draw[->, ikvorange] (heap.south) -- ++(0,-0.55) -| node[font=\sffamily\tiny, text=ikvorange, pos=0.25, right] {miss / timeout} (m2.north);
\draw[->, ikvblue] (hit.east) -- (m2.west);
\draw[->, ikvgray, dashed] (skip.north) -- (heap.south);
\node[font=\sffamily\tiny, text=ikvgray] at (0,-1.55)
  {M3 never grows the admit set and never rotates $K$. Headline keeps it off.};
\end{tikzpicture}
\endgroup
