\begingroup
\definecolor{ikvblue}{HTML}{2F6DB3}
\definecolor{ikvnavy}{HTML}{1B4F8A}
\definecolor{ikvteal}{HTML}{5BB3A7}
\definecolor{ikvorange}{HTML}{D96B2B}
\definecolor{ikvgray}{HTML}{6B6B6B}
\definecolor{reqfill}{HTML}{D6E6F5}
\definecolor{ownfill}{HTML}{F8E3D2}
\definecolor{band}{HTML}{F4F7FA}
\begin{tikzpicture}[
  font=\sffamily\scriptsize,
  >=Stealth,
  every node/.style={align=center},
  slot/.style={minimum width=0.95cm, minimum height=0.34cm,
    font=\sffamily\tiny, inner sep=1pt,
    text height=0.7em, text depth=0.12em},
]
% Physical tensor. Drawn rectangles so Fandol cannot grow the frame.
\fill[band, rounded corners=3pt] (-4.35,2.20) rectangle (4.35,3.32);
\node[font=\sffamily\scriptsize\bfseries, text=ikvnavy, anchor=west]
  at (-4.2,3.14) {One physical $K/V$ tensor};
\node[font=\sffamily\tiny, text=ikvgray, anchor=east]
  at (4.2,3.14) {page\_size $=1$, fraction $0.82$};
\node[slot, draw=ikvblue, fill=reqfill] at (-2.55,2.55) {req};
\node[slot, draw=ikvblue, fill=reqfill] at (-1.40,2.55) {req};
\node[slot, draw=ikvorange, fill=ownfill] at (-0.25,2.55) {own};
\node[slot, draw=ikvorange, fill=ownfill] at (0.90,2.55) {own};
\node[slot, draw=ikvblue, fill=reqfill] at (2.05,2.55) {req};
\node[slot, draw=ikvgray, fill=white] at (3.20,2.55) {free};

% Owner frames are fixed rectangles, not auto-sized nodes.
\draw[ikvblue, thick, rounded corners=3pt, fill=white]
  (-4.20,0.28) rectangle (-0.25,1.95);
\node[font=\sffamily\scriptsize\bfseries, text=ikvblue, anchor=north west]
  at (-4.05,1.88) {Request owner};
\node[font=\sffamily\tiny, anchor=north west] at (-4.05,1.55) {\texttt{ReqToTokenPool}};
\node[font=\sffamily\tiny, anchor=north west] at (-4.05,1.28) {Dense prefix / suffix};
\node[font=\sffamily\tiny, anchor=north west] at (-4.05,1.01) {Freed when the request ends};

\draw[ikvorange, thick, rounded corners=3pt, fill=white]
  (0.25,0.28) rectangle (4.20,1.95);
\node[font=\sffamily\scriptsize\bfseries, text=ikvorange, anchor=north west]
  at (0.40,1.88) {Lease owner};
\node[font=\sffamily\tiny, anchor=north west] at (0.40,1.55) {\texttt{KVSegmentStore}};
\node[font=\sffamily\tiny, anchor=north west] at (0.40,1.28) {Rotate $K$, pin lease};
\node[font=\sffamily\tiny, anchor=north west] at (0.40,1.01) {Host overflow if alloc fails};

% Free list sits fully below both frames (south edge y=0.28).
\node[draw=ikvteal, fill=white, rounded corners=3pt, inner sep=4pt,
  minimum height=0.46cm, minimum width=2.7cm,
  text height=0.75em, text depth=0.15em] (alloc) at (0,-0.28)
  {shared free list};
\draw[->, ikvblue, thick, shorten >=1pt] (-2.225,0.28) -- (-2.225,-0.28) -- (alloc.west);
\draw[->, ikvorange, thick, shorten >=1pt] (2.225,0.28) -- (2.225,-0.28) -- (alloc.east);

\node[font=\sffamily\tiny, text=ikvgray] at (0,-0.80)
  {\texttt{alloc}($L$) from one free list. If pages run out: evict radix, then host copy, else Dense.};
\end{tikzpicture}
\endgroup
