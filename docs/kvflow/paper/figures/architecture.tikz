\begingroup
\definecolor{ikvblue}{HTML}{2F6DB3}
\definecolor{ikvnavy}{HTML}{1B4F8A}
\definecolor{ikvteal}{HTML}{5BB3A7}
\definecolor{ikvorange}{HTML}{D96B2B}
\definecolor{ikvgray}{HTML}{6B6B6B}
\definecolor{offfill}{HTML}{E8F4F0}
\definecolor{onfill}{HTML}{EAF1F8}
\definecolor{dimfill}{HTML}{F2F2F2}
\definecolor{poolfill}{HTML}{F7F4EC}
\definecolor{reqfill}{HTML}{D6E6F5}
\definecolor{ownfill}{HTML}{F8E3D2}
\begin{tikzpicture}[
  font=\sffamily\scriptsize,
  >=Stealth,
]
% --- Offline ---
\fill[offfill, rounded corners=3pt] (-4.15,1.05) rectangle (4.15,2.28);
\node[anchor=west, font=\sffamily\scriptsize\bfseries, text=ikvteal]
  at (-4.02,2.12) {Offline once};
\node[draw=ikvteal, fill=white, rounded corners=2pt, align=center,
  inner sep=3pt, text width=2.15cm, minimum height=0.72cm] (traj) at (-2.55,1.48)
  {Frozen traces};
\node[draw=ikvteal, fill=white, rounded corners=2pt, align=center,
  inner sep=3pt, text width=2.55cm, minimum height=0.72cm] (m0) at (0.15,1.48)
  {\textbf{M0 admit}\\token-ID, version, $\Delta\neq 0$};
\node[draw=ikvnavy, fill=white, rounded corners=2pt, align=center,
  inner sep=3pt, text width=1.55cm, minimum height=0.72cm] (plan) at (3.05,1.48)
  {PLAN $(s,t,L,\Delta)$};
\draw[->, ikvteal, thick] (traj) -- (m0);
\draw[->, ikvteal, thick] (m0) -- (plan);

% --- Online ---
\fill[onfill, rounded corners=3pt] (-4.15,-2.72) rectangle (4.15,0.92);
\node[anchor=west, font=\sffamily\scriptsize\bfseries, text=ikvnavy]
  at (-4.02,0.76) {Online prefill (one TokenToKVPool)};

\node[draw=ikvblue, fill=white, rounded corners=2pt, align=center,
  inner sep=2.6pt, text width=1.35cm, minimum height=0.70cm] (src) at (-3.15,0.18)
  {Source\\Dense};
\node[draw=ikvblue, fill=white, rounded corners=2pt, align=center,
  inner sep=2.6pt, text width=1.85cm, minimum height=0.70cm] (mat) at (-1.05,0.18)
  {Materialize\\$K{\leftarrow}R_{\Delta}K$};
\node[draw=ikvorange, fill=white, rounded corners=2pt, align=center,
  inner sep=2.6pt, text width=1.55cm, minimum height=0.70cm] (lease) at (1.15,0.18)
  {Lease store};
\node[draw=ikvnavy, fill=white, rounded corners=2pt, align=center,
  inner sep=2.6pt, text width=1.85cm, minimum height=0.70cm] (tgt) at (3.15,0.18)
  {Target copy};
\draw[->, ikvblue, thick] (src) -- (mat);
\draw[->, ikvblue, thick] (mat) -- (lease);
\draw[->, ikvblue, thick] (lease) -- (tgt);
\draw[->, ikvgray, dashed] (plan.south) -- ++(0,-0.22) -| (src.north);

\node[draw=ikvblue, fill=white, rounded corners=2pt, align=center,
  inner sep=2.4pt, text width=1.45cm] (p) at (-3.15,-0.78) {Dense prefix};
\node[draw=ikvblue, fill=white, rounded corners=2pt, align=center,
  inner sep=2.4pt, line width=0.9pt, text width=1.85cm] (c) at (-0.55,-0.78)
  {\textbf{M2 whole-island}};
\node[draw=ikvorange, fill=white, rounded corners=2pt, align=center,
  inner sep=2.4pt, text width=1.45cm] (f) at (1.85,-0.78) {miss $\to$ Dense};
\node[draw=ikvnavy, fill=white, rounded corners=2pt, align=center,
  inner sep=2.4pt, text width=1.55cm] (d) at (3.45,-0.78) {Dense rest};
\draw[->, ikvblue] (p) -- (c);
\draw[->, ikvorange] (c) -- (f);
\draw[->, ikvblue] (c) -- (d);
\draw[->, ikvgray, dashed] (tgt.south) -- (c.north);

\node[draw=ikvgray, fill=dimfill, rounded corners=2pt, align=center,
  inner sep=2pt, text width=1.55cm, font=\sffamily\tiny] (m1) at (-2.35,-1.52)
  {M1 radix\\off in headline};
\node[draw=ikvgray, fill=dimfill, rounded corners=2pt, align=center,
  inner sep=2pt, text width=1.55cm, font=\sffamily\tiny] (m3) at (0.15,-1.52)
  {M3 prefetch\\off in headline};
\node[draw=ikvnavy, fill=white, rounded corners=2pt, align=center,
  inner sep=2pt, text width=2.35cm] (dec) at (2.55,-1.52) {1-token decode};
\draw[->, ikvgray, dashed] (m1.north) -- (p.south);
\draw[->, ikvgray, dashed] (m3.east) -- node[font=\sffamily\tiny, text=ikvgray, above] {miss $\to$ owned} (c.south);
\draw[->, ikvblue, thick] (d.south) |- (dec.east);

% --- Pool strip ---
\fill[poolfill, rounded corners=2pt] (-4.05,-2.58) rectangle (4.05,-1.88);
\node[font=\sffamily\tiny\bfseries, text=ikvgray, anchor=west] at (-3.95,-2.00)
  {Same TokenToKVPool};
\node[draw=ikvblue, fill=reqfill, minimum width=0.92cm, minimum height=0.36cm,
  font=\sffamily\tiny, inner sep=0pt] at (-2.35,-2.32) {req};
\node[draw=ikvblue, fill=reqfill, minimum width=0.92cm, minimum height=0.36cm,
  font=\sffamily\tiny, inner sep=0pt] at (-1.35,-2.32) {req};
\node[draw=ikvorange, fill=ownfill, minimum width=0.92cm, minimum height=0.36cm,
  font=\sffamily\tiny, inner sep=0pt] at (-0.35,-2.32) {own};
\node[draw=ikvorange, fill=ownfill, minimum width=0.92cm, minimum height=0.36cm,
  font=\sffamily\tiny, inner sep=0pt] at (0.65,-2.32) {own};
\node[draw=ikvblue, fill=reqfill, minimum width=0.92cm, minimum height=0.36cm,
  font=\sffamily\tiny, inner sep=0pt] at (1.65,-2.32) {req};
\node[draw=ikvgray, fill=white, minimum width=0.92cm, minimum height=0.36cm,
  font=\sffamily\tiny, inner sep=0pt] at (2.65,-2.32) {free};
\node[font=\sffamily\tiny, text=ikvgray, anchor=east] at (3.95,-2.32) {no static split};
\end{tikzpicture}
