\begingroup
\definecolor{ikvblue}{HTML}{2F6DB3}
\definecolor{ikvnavy}{HTML}{1B4F8A}
\definecolor{ikvteal}{HTML}{5BB3A7}
\definecolor{ikvorange}{HTML}{D96B2B}
\definecolor{ikvgray}{HTML}{6B6B6B}
\definecolor{offfill}{HTML}{E8F4F0}
\definecolor{onfill}{HTML}{EAF1F8}
\definecolor{dimfill}{HTML}{F2F2F2}
\definecolor{poolfill}{HTML}{F7F4EC}
\definecolor{reqfill}{HTML}{D6E6F5}
\definecolor{ownfill}{HTML}{F8E3D2}
\begin{tikzpicture}[
  font=\sffamily\scriptsize,
  >=Stealth,
  every node/.style={align=center},
  box/.style={draw=#1, fill=white, rounded corners=2pt, inner sep=3pt,
    minimum height=0.74cm},
]
% Eval harness (not the served class prior)
\fill[offfill, rounded corners=3pt] (-4.35,2.52) rectangle (4.35,3.88);
\node[font=\sffamily\scriptsize\bfseries, text=ikvteal, anchor=west]
  at (-4.20,3.70) {Eval (once): offline-oracle PLAN};
\node[box=ikvteal, text width=2.15cm] (traj) at (-2.65,3.05) {Frozen traces};
\node[box=ikvteal, text width=2.45cm] (m0) at (0.15,3.05)
  {M0 admit\\[-1pt]{\tiny token-ID, version, shift}};
\node[box=ikvnavy, text width=1.90cm] (plan) at (3.05,3.05)
  {Eval PLAN\\[-1pt]{\tiny known $\Delta$}};
\draw[->, ikvteal, thick] (traj) -- (m0);
\draw[->, ikvteal, thick] (m0) -- (plan);

% Online. Happy path is one row; fail is a stub under M2, not on the row.
\fill[onfill, rounded corners=3pt] (-4.35,-1.08) rectangle (4.35,2.40);
\node[font=\sffamily\scriptsize\bfseries, text=ikvnavy, anchor=west]
  at (-4.20,2.22) {Online prefill (class prior)};
\node[box=ikvblue, text width=1.55cm] (src) at (-3.25,1.58) {Source Dense};
\node[box=ikvblue, text width=1.80cm] (mat) at (-1.15,1.58)
  {Materialize\\[-1pt]{\tiny rotate $K$}};
\node[box=ikvorange, text width=1.55cm] (lease) at (1.05,1.58) {Lease store};
\node[box=ikvnavy, text width=1.55cm] (tgt) at (3.25,1.58) {Target};
\draw[->, ikvblue, thick] (src) -- (mat);
\draw[->, ikvblue, thick] (mat) -- (lease);
\draw[->, ikvblue, thick] (lease) -- (tgt);

\node[box=ikvblue, text width=1.55cm] (p) at (-3.25,0.48) {Dense prefix};
\node[box=ikvblue, line width=0.9pt, text width=1.80cm] (c) at (-1.15,0.48)
  {\textbf{M2 copy}};
\node[box=ikvnavy, text width=1.55cm] (d) at (1.05,0.48) {Dense rest};
\node[box=ikvnavy, text width=1.55cm] (dec) at (3.25,0.48) {1-token decode};
\draw[->, ikvblue, thick] (p) -- (c);
\draw[->, ikvblue, thick] (c) -- (d);
\draw[->, ikvblue, thick] (d) -- (dec);

% Fail stub under M2 only. No arrow through another box.
\node[box=ikvorange, text width=1.55cm, minimum height=0.56cm] (f) at (-1.15,-0.38)
  {else Dense};
\draw[->, ikvorange] (c.south) -- (f.north);
\draw[->, ikvorange] (f.east) -- ++(0.45,0) |- (d.south);

\node[draw=ikvgray, fill=dimfill, rounded corners=2pt, inner sep=2pt,
  text width=1.55cm, font=\sffamily\tiny,
  text height=0.7em, text depth=0.12em] (m1) at (-3.25,-0.38)
  {M1 radix: off};
\node[draw=ikvgray, fill=dimfill, rounded corners=2pt, inner sep=2pt,
  text width=1.55cm, font=\sffamily\tiny,
  text height=0.7em, text depth=0.12em] (m3) at (3.25,-0.38)
  {M3 prefetch: off};

% Pool
\fill[poolfill, rounded corners=2pt] (-4.35,-1.98) rectangle (4.35,-1.18);
\node[font=\sffamily\tiny\bfseries, text=ikvgray, anchor=west]
  at (-4.20,-1.38) {Same TokenToKVPool};
\node[draw=ikvblue, fill=reqfill, minimum width=0.80cm, minimum height=0.30cm,
  font=\sffamily\tiny, inner sep=0pt, text height=0.65em, text depth=0.1em]
  at (-1.55,-1.70) {req};
\node[draw=ikvblue, fill=reqfill, minimum width=0.80cm, minimum height=0.30cm,
  font=\sffamily\tiny, inner sep=0pt, text height=0.65em, text depth=0.1em]
  at (-0.62,-1.70) {req};
\node[draw=ikvorange, fill=ownfill, minimum width=0.80cm, minimum height=0.30cm,
  font=\sffamily\tiny, inner sep=0pt, text height=0.65em, text depth=0.1em]
  at (0.31,-1.70) {own};
\node[draw=ikvorange, fill=ownfill, minimum width=0.80cm, minimum height=0.30cm,
  font=\sffamily\tiny, inner sep=0pt, text height=0.65em, text depth=0.1em]
  at (1.24,-1.70) {own};
\node[draw=ikvgray, fill=white, minimum width=0.80cm, minimum height=0.30cm,
  font=\sffamily\tiny, inner sep=0pt, text height=0.65em, text depth=0.1em]
  at (2.17,-1.70) {free};
\node[font=\sffamily\tiny, text=ikvgray, anchor=east] at (4.20,-1.70)
  {no static split};
\end{tikzpicture}
\endgroup
