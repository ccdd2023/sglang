\begingroup
\definecolor{ikvblue}{HTML}{2F6DB3}
\definecolor{ikvnavy}{HTML}{1B4F8A}
\definecolor{ikvteal}{HTML}{5BB3A7}
\definecolor{ikvorange}{HTML}{D96B2B}
\definecolor{ikvgray}{HTML}{6B6B6B}
\definecolor{offfill}{HTML}{EEF7F4}
\definecolor{onfill}{HTML}{EEF3FA}
\definecolor{dimfill}{HTML}{F3F3F3}
\begin{tikzpicture}[
  font=\sffamily\scriptsize,
  >=Stealth,
  box/.style={draw=#1, fill=white, rounded corners=2pt, align=center,
    inner sep=3.2pt, minimum height=0.80cm},
]
\node[fill=offfill, rounded corners=3pt, minimum width=8.3cm, minimum height=1.32cm] (offbg) at (0,0.06) {};
\node[anchor=north west, font=\sffamily\scriptsize\bfseries, text=ikvnavy]
  at ($(offbg.north west)+(0.1,-0.04)$) {Offline (once)};
\node[box=ikvteal, text width=2.25cm] (traj) at (-2.45, -0.04) {Frozen SWE-bench\\trajectories};
\node[box=ikvteal, text width=2.45cm] (m0) at (0.25, -0.04) {M0 compiler\\token-ID, version, $\Delta\neq 0$};
\node[box=ikvnavy, text width=1.40cm] (plan) at (3.15, -0.04) {PLAN};
\draw[->, ikvgray, thick] (traj) -- (m0);
\draw[->, ikvgray, thick] (m0) -- (plan);

\node[fill=onfill, rounded corners=3pt, minimum width=8.3cm, minimum height=3.05cm] (onbg) at (0,-2.48) {};
\node[anchor=north west, font=\sffamily\scriptsize\bfseries, text=ikvnavy]
  at ($(onbg.north west)+(0.1,-0.04)$) {Online prefill (SGLang)};
\node[box=ikvblue, text width=1.22cm] (tgt) at (-3.22, -1.68) {Target\\token IDs};
\node[box=ikvblue, text width=1.22cm] (pref) at (-1.70, -1.68) {Dense\\prefix};
\node[box=ikvblue, text width=1.95cm, line width=0.9pt] (m2) at (0.22, -1.68)
  {\textbf{M2 island copy}\\$K{\leftarrow}R_{\Delta}K$, $V$ as-is};
\node[box=ikvorange, text width=1.55cm] (fail) at (3.05, -1.68) {miss $\to$\\Dense island};
\node[box=ikvgray, fill=dimfill, text width=1.42cm] (m1) at (-3.22, -2.68) {M1 prefix\\{\tiny off in headline}};
\node[box=ikvgray, fill=dimfill, text width=1.42cm] (m3) at (-1.70, -2.68) {M3 prefetch\\{\tiny off in headline}};
\node[box=ikvnavy, text width=3.35cm] (dec) at (0.85, -3.62) {Dense remainder $\to$ 1-token decode};
\draw[->, ikvgray, thick] (plan.south) -- ++(0,-0.18) -| (tgt.north);
\draw[->, ikvblue, thick] (tgt) -- (pref);
\draw[->, ikvblue, thick] (pref) -- (m2);
\draw[->, ikvorange] (m2) -- node[font=\sffamily\tiny, text=ikvorange, above] {miss} (fail);
\draw[->, ikvblue, thick] (m2.south) -- node[font=\sffamily\tiny, text=ikvblue, right] {hit} (dec.north west);
\draw[->, ikvorange] (fail.south) -- ++(0,-1.18) -| (dec.east);
\draw[->, ikvgray, dashed] (m1.north) -- (tgt.south);
\draw[->, ikvgray, dashed] (m3.east) -- node[font=\sffamily\tiny, text=ikvgray, above] {miss $\to$ M2} (m2.south west);
\end{tikzpicture}
\endgroup
